{
    "tasks": [
        {
            "label": "Build",
            "dependsOn": [
                "SetUp",
                "Compile CUDA",
                "Compile C++",
                "Linker"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "SetUp",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-command",
                "if (-not (Test-Path '${workspaceFolder}/bin'))",
                "{New-Item -ItemType Directory -Path '${workspaceFolder}/bin'};",
                "if (-not (Test-Path '${workspaceFolder}/bin/opencv_world4110.dll'))",
                "{Copy-Item -Path '${env:appData}/programming_libraries/cpp_libraries/opencv/build/x64/vc16/bin/opencv_world4110.dll'",
                "-Destination '${workspaceFolder}/bin'}"
            ]
        },
        {
            "label": "Compile CUDA",
            "type": "shell",
            "command": "nvcc",
            "args": [
                "-I=${workspaceFolder}",
                "-c",
                "${workspaceFolder}/src/GPU/image_blur_module/image_blur_api.cu",
                "${workspaceFolder}/src/GPU/image_blur_module/image_blur_operator.cu",
                "-odir",
                "${workspaceFolder}/bin"
            ]
        },
        {
            "label": "Compile C++",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/I",
                "${env:appData}/programming_libraries/cpp_libraries/opencv/build/include",
                "/I",
                "${env:ProgramFiles(x86)}/Windows Kits/10/Include",
                "/I",
                "${workspaceFolder}",
                "/c",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/UI/*.cpp",
                "${workspaceFolder}/src/CPU/*.cpp",
                "/Fo${workspaceFolder}/bin/"
            ]
        },
        {
            "label": "Linker",
            "type": "shell",
            "command": "link.exe",
            "args": [
                "${workspaceFolder}/bin/*.obj",
                "/LIBPATH:${env:appData}/programming_libraries/cpp_libraries/opencv/build/x64/vc16/lib",
                "opencv_world4110.lib",
                "/LIBPATH:${env:ProgramFiles}/NVIDIA GPU Computing Toolkit/CUDA/v11.6/lib/x64",
                "cudart.lib",
                "/LIBPATH:${env:ProgramFiles(x86)}/Windows Kits/10/Lib/10.0.17763.0/um/x64",
                "ComDlg32.Lib",
                "/OUT:${workspaceFolder}/bin/app.exe"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}